# Copy this file to `.env` and fill in the values.
# `.env` is gitignored — NEVER commit it.
#
# OVERLEAF_SESSION2 is your logged-in session cookie. It grants full access to
# your Overleaf account, so treat it exactly like a password. Logging out of
# Overleaf in the browser invalidates it.
#
# Where to find it:
#   Browser devtools → Application → Cookies → https://www.overleaf.com
#   → copy the VALUE of the `overleaf_session2` cookie.

OVERLEAF_BASE_URL=https://www.overleaf.com
OVERLEAF_SESSION2=
OVERLEAF_PROJECT_ID=
